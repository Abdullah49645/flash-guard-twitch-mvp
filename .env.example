# Local dashboard and OBS overlay
PORT=4173
HOST=127.0.0.1

# Twitch developer app and user access token (keep private)
TWITCH_CLIENT_ID=
TWITCH_USER_ACCESS_TOKEN=
TWITCH_BROADCASTER_ID=
TWITCH_BOT_USER_ID=
TWITCH_CHANNEL_LOGIN=
# Optional; defaults to !media
TWITCH_COMMAND=!media

# Retrieval limits (MVP supports direct MP4 only; requires ffmpeg/ffprobe)
MAX_MEDIA_BYTES=25000000
MAX_DURATION_SECONDS=120
MAX_DIMENSION=1920
MAX_FRAMES=3600

# Local frame safety model: a class score at or above this value is surfaced for review
VISUAL_SIGNAL_THRESHOLD=0.5

# Optional audio fingerprint lookup (registered AcoustID application key)
# Free AcoustID web service is for non-commercial use and sends fingerprints/duration, not media.
ACOUSTID_CLIENT_KEY=
